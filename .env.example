# Copy to .env (never commit .env). Real environment variables override this file.
# You can also set these from the web UI: Settings tab.

DCP_AI_ENABLED=1
# anthropic | openai  (openai also covers any OpenAI-compatible host via DCP_LLM_API_BASE)
DCP_LLM_PROVIDER=anthropic
DCP_LLM_MODEL=claude-sonnet-5-5
DCP_LLM_API_KEY=
# Optional: custom endpoint (e.g. a proxy or OpenAI-compatible server)
DCP_LLM_API_BASE=
